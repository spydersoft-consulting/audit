<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<UserSecretsId>spydersoft-audit-api</UserSecretsId>
		<IsPackable>false</IsPackable>
		<!-- XML doc comments feed the OpenAPI document with descriptions/summaries.
		     1591 = "Missing XML comment for publicly visible type or member" — too noisy
		     to require everywhere; we only document the things that need it. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Spydersoft.Platform.Hosting" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" />
		<PackageReference Include="MongoDB.Driver" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Spydersoft.Audit.Client\Spydersoft.Audit.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Spydersoft.AuditApi.UnitTests" />
	</ItemGroup>

</Project>
