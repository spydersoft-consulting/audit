{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "https://localhost:17120;http://localhost:15140",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "https://localhost:21123",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "https://localhost:22123",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "applicationUrl": "http://localhost:15140",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19120",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:20120",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
      }
    },
    "Testing": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:15140",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Testing",
        "DOTNET_ENVIRONMENT": "Testing",
        "DOTNET_DASHBOARD_OTLP_ENDPOINT_URL": "http://localhost:19120",
        "DOTNET_RESOURCE_SERVICE_ENDPOINT_URL": "http://localhost:20120",
        "ASPIRE_ALLOW_UNSECURED_TRANSPORT": "true"
      }
